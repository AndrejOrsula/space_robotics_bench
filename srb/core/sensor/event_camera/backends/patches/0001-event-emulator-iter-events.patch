+        rejected until their ordering/state contracts are implemented.
+        """
+        if not isinstance(max_events_per_chunk, int) or max_events_per_chunk <= 0:
+            raise ValueError("max_events_per_chunk must be a positive integer")
+        if not isinstance(max_workspace_events, int) or max_workspace_events <= 0:
+            raise ValueError("max_workspace_events must be a positive integer")
+        if max_events_per_chunk > max_workspace_events:
+            raise ValueError(
+                "max_events_per_chunk cannot exceed max_workspace_events"
+            )
+        if self.shot_noise_rate_hz > 0 or self.photoreceptor_noise:
+            raise RuntimeError(
+                "iter_events requires shot noise and photoreceptor noise to be disabled"
+            )
+        if self.csdvs_enabled or self.scidvs:
+            raise RuntimeError("iter_events does not support CSDVS or SCIDVS")
+        if (
+            self.frame_h5_dataset is not None
+            or self.dvs_h5 is not None
+            or self.dvs_aedat2 is not None
+            or self.dvs_aedat4 is not None
+            or self.dvs_text is not None
+            or self.show_dvs_model_state is not None
+            or self.record_single_pixel_states is not None
+        ):
+            raise RuntimeError("iter_events does not support v2e output or diagnostics")
+
+        if t_frame < self.t_previous:
+            raise ValueError(
+                "this frame time={} must be later than previous frame time={}"
+                .format(t_frame, self.t_previous)
+            )
+        self.frame_counter += 1
+
+        delta_time = t_frame - self.t_previous
+        if self.log_input and new_frame.dtype != np.float32:
+            logger.warning("log_frame is True but input frame is not np.float32")
+
+        self.new_frame = torch.tensor(new_frame, dtype=torch.float64, device=self.device)
